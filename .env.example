# =============================================================================
# SupportLens Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The application will work without GEMINI_API_KEY (degraded mode):
# - Chat endpoint returns 503 errors
# - Classification defaults to "General_Inquiry"
# - All other features work normally
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=supportlens
DATABASE_USER=root
DATABASE_PASSWORD=supportlens123

# Database type: mysql or postgresql
DATABASE_TYPE=mysql

# -----------------------------------------------------------------------------
# Gemini API Configuration (Optional)
# -----------------------------------------------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey
# Leave empty to run in degraded mode (fallback classification)
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Enable debug mode (verbose logging, SQL queries)
DEBUG=false
