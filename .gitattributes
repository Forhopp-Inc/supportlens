# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must have LF line endings
*.sh text eol=lf

# Windows batch files must have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
